    <!-- Tạo bảng Coins -->
    <changeSet id="20250311-01-insert-coins" author="your_name">
        <insert tableName="m_coins">
            <column name="id" value="1"/>
            <column name="symbol" value="SOL_TEST"/>
            <column name="name" value="Solana Testnet"/>
            <column name="logo_url" value="https://example.com/solana-logo.png"/>
            <column name="is_enabled" valueNumeric="1"/>
            <column name="created_by" value="SYSTEM"/>
        </insert>

        <insert tableName="m_coins">
            <column name="id" value="2"/>
            <column name="symbol" value="ETH_TEST6"/>
            <column name="name" value="Ethereum Testnet 6"/>
            <column name="logo_url" value="https://example.com/ethereum-logo.png"/>
            <column name="is_enabled" valueNumeric="1"/>
            <column name="created_by" value="SYSTEM"/>
        </insert>
    </changeSet>

    <!-- Tạo bảng Networks -->
    <changeSet id="20250311-02-insert-networks" author="your_name">
        <insert tableName="m_networks">
            <column name="id" value="1"/>
            <column name="name" value="Solana Testnet"/>
            <column name="network_type" value="SOLANA"/>
            <column name="is_enabled" valueNumeric="1"/>
            <column name="created_by" value="SYSTEM"/>
        </insert>

        <insert tableName="m_networks">
            <column name="id" value="2"/>
            <column name="name" value="Ethereum Testnet 6"/>
            <column name="network_type" value="ETHEREUM"/>
            <column name="is_enabled" valueNumeric="1"/>
            <column name="created_by" value="SYSTEM"/>
        </insert>
    </changeSet>

