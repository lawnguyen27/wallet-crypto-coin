<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Tạo bảng Coins -->
    <changeSet id="20250311-01-insert-coins" author="your_name">
        <insert tableName="m_coins">
            <column name="id" value="1"/>
            <column name="symbol" value="SOL_TEST"/>
            <column name="name" value="Solana Testnet"/>
            <column name="logo_url" value="https://example.com/solana-logo.png"/>
            <column name="is_enabled" valueNumeric="1"/>
            <column name="created_by" value="SYSTEM"/>
        </insert>

        <insert tableName="m_coins">
            <column name="id" value="2"/>
            <column name="symbol" value="ETH_TEST6"/>
            <column name="name" value="Ethereum Testnet 6"/>
            <column name="logo_url" value="https://example.com/ethereum-logo.png"/>
            <column name="is_enabled" valueNumeric="1"/>
            <column name="created_by" value="SYSTEM"/>
        </insert>
    </changeSet>

    <!-- Tạo bảng Networks -->
    <changeSet id="20250311-02-insert-networks" author="your_name">
        <insert tableName="m_networks">
            <column name="id" value="1"/>
            <column name="name" value="Solana Testnet"/>
            <column name="network_type" value="SOLANA"/>
            <column name="is_enabled" valueNumeric="1"/>
            <column name="created_by" value="SYSTEM"/>
        </insert>

        <insert tableName="m_networks">
            <column name="id" value="2"/>
            <column name="name" value="Ethereum Testnet 6"/>
            <column name="network_type" value="ETHEREUM"/>
            <column name="is_enabled" valueNumeric="1"/>
            <column name="created_by" value="SYSTEM"/>
        </insert>
    </changeSet>

    <!-- Chèn dữ liệu vào bảng trung gian -->
    <changeSet id="20250311-04-insert-coin-network" author="your_name">
        <!-- Giả sử Solana Testnet hỗ trợ SOL_TEST -->
        <insert tableName="m_coin_networks">
            <column name="fk_coin_id" value="1"/>
            <column name="fk_network_id" value="1"/>
        </insert>

        <!-- Giả sử Ethereum Testnet 6 hỗ trợ ETH_TEST6 -->
        <insert tableName="m_coin_networks">
            <column name="fk_coin_id" value="2"/>
            <column name="fk_network_id" value="2"/>
        </insert>
    </changeSet>
    <!-- Chèn dữ liệu vào bảng Limit Tokens -->
    <changeSet id="20250311-05-insert-limit-tokens" author="your_name">
        <insert tableName="m_limit_tokens">
            <column name="id" value="1"/>
            <column name="limit_quantity" valueNumeric="0.00002100000021"/>
            <column name="fk_coin_id" value="1"/>
            <column name="created_by" value="SYSTEM"/>

        </insert>

        <insert tableName="m_limit_tokens">
            <column name="id" value="2"/>
            <column name="limit_quantity" valueNumeric="0.00002100000021"/>
            <column name="fk_coin_id" value="2"/>
            <column name="created_by" value="SYSTEM"/>

        </insert>
    </changeSet>

</databaseChangeLog>
